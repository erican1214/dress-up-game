<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Dress-Up Game</title>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Game</title>
        <link rel="stylesheet" href="style.css">
        <script src="script.js" defer></script>
    </head>
    <body>
        <div class="titleContainer">
            <h1>What should I wear today?</h1>
        </div>
        <div class="dressUpContainer">
        <div class="characterContainer">
            <label>
                <input type="checkbox">
                <img id="mainBody" src="assets/dress_up_elements/skins/skin_3.png">
                <img id="hair" style="display:none">
                <img id="pants" style="display:none">
                <img id="shirt" style="display:none">
                <img id="dress" style="display:none">
                <img id="frontHair" style="display:none">
                <img id="socks" style="display:none">
                <img id ="shoes" style="display:none">
            </label>
        </div>
        <div class="closetContainer">
            <div class="innerClosetContainer">
                <div class="optionPanel">
                    <button id="skinButton" class="optionButton"></button>
                    <button id="hairButton" class="optionButton"></button>
                    <button id="shirtButton" class="optionButton"></button>
                    <button id="pantsButton" class="optionButton"></button>
                    <button id="dressButton" class="optionButton"></button>
                    <button id="sockButton" class="optionButton"></button>
                    <button id="shoeButton" class="optionButton"></button>
                </div>
                <div class="selectionContainer">
                    <div id="skinSelection" class="selection">
                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_1_icon.png" />
                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_2_icon.png" />
                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_3_icon.png" />
                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_4_icon.png" />
