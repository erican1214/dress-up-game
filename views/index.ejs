                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_7_icon.png" />
                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_8_icon.png" />
                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_9_icon.png" />
                        <input type="image" class="skinOptions" src="assets/dress_up_icons/skins/skin_10_icon.png" />
                    </div>
                    <div id="hairSelection" class="selection" style="display:none">
                        <input type="image" class="hairOptions" src="assets/dress_up_icons/hair/hair_1_icon.png" />
                        <input type="image" class="hairOptions" src="assets/dress_up_icons/hair/hair_2_icon.png" />
                        <input type="image" class="hairOptions" src="assets/dress_up_icons/hair/hair_3_icon.png" />
                        <input type="image" class="hairOptions" src="assets/dress_up_icons/hair/hair_4_icon.png" />
